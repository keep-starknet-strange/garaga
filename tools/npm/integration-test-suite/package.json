{
  "name": "integration-test-suite",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "install-browser": "puppeteer browsers install chrome@pinned",
    "test": "npm run build && npm run test --workspaces",
    "test-generate": "npm run build && npm run test-generate --workspaces"
  },
  "devDependencies": {
    "puppeteer": "^25.17.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "garaga": "file:garaga.tgz"
  }
}
