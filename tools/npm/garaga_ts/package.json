{
  "type": "module",
  "name": "garaga",
  "version": "1.1.0",
  "description": "State-of-the-art Elliptic Curve operations and SNARKS verification for Cairo & Starknet 🐺",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "./dist/",
    "LICENSES",
    "README.md",
    "API.md"
  ],
  "keywords": [
    "elliptic-curves",
    "cryptography",
    "zk-snarks",
    "zero-knowledge",
    "pairing",
    "starknet",
    "cairo",
    "groth16",
    "noir",
    "honk",
    "blockchain",
    "wasm",
    "typescript",
    "rust"
  ],
  "author": {
    "name": "feltroidprime"
  },
  "contributors": [
    "Keep Starknet Strange Contributors"
  ],
  "license": "MIT",
  "homepage": "https://github.com/keep-starknet-strange/garaga",
  "repository": {
    "type": "git",
    "url": "https://github.com/keep-starknet-strange/garaga.git",
    "directory": "tools/npm/garaga_ts"
  },
  "bugs": {
    "url": "https://github.com/keep-starknet-strange/garaga/issues"
  },
  "documentation": "https://garaga.gitbook.io/",
  "scripts": {
    "build:wasm": "cd ../../garaga_rs && RUSTFLAGS='--cfg getrandom_backend=\"wasm_js\"' wasm-pack build --target web --out-dir ../npm/garaga_ts/src/wasm/pkg --release --no-default-features --features wasm",
    "patch:wasm": "node patch.wasm.cjs",
    "build:ts": "node -e \"require('node:fs').rmSync('.build', { recursive: true, force: true })\" && tsc",
    "build:node": "npm run build:ts && rollup -c",
    "build": "npm run build:wasm && npm run patch:wasm && npm run build:node",
    "prepare": "npm run build:node",
    "test": "npm run build:ts && node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include=\".build/src/**/*.js\" --test-coverage-exclude=\".build/src/wasm/**\" --test \".build/tests/**/*.test.js\"",
    "test:watch": "npm run build:ts && node --experimental-test-module-mocks --test --watch \".build/tests/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "rollup": "^4.24.0",
    "rollup-plugin-dts": "^6.1.1",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "browser": {
    "fs": false
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
